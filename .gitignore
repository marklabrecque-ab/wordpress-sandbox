# WordPress configuration
web/wp-config.php

# WordPress uploads and generated content
web/wp-content/uploads/
web/wp-content/upgrade/
web/wp-content/backup-db/
web/wp-content/backups/
web/wp-content/cache/
web/wp-content/blogs.dir/

# WordPress debug log
web/wp-content/debug.log

# Environment files
.env
.env.*
!.env.example

# Composer
vendor/
composer.lock

# WordPress core ships React/ReactDOM/Moment/etc. in this `vendor/` directory.
# The generic Composer `vendor/` rule above would otherwise exclude it, which
# leaves the block editor unable to boot (blank screen, React 404s). Keep it.
!web/wp-includes/js/dist/vendor/
!web/wp-includes/js/dist/vendor/**

# Node
node_modules/
npm-debug.log*
yarn-error.log

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
